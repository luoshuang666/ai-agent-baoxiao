# 复制本文件为 .env，填入你自己的 Key；本文件只放占位符，不要写真实 Key
# DeepSeek（对话模型，OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-你的deepseek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 若你的账号仍是旧模型名，可改成 deepseek-chat
LLM_MODEL=deepseek-flash

# 硅基流动（Embedding，OpenAI 兼容协议）
SILICONFLOW_API_KEY=sk-你的硅基流动密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMB_MODEL=Qwen/Qwen3-Embedding-0.6B
EMB_DIM=1024

# 检索开关
USE_BM25=1

# 多轮记忆：送进模型的最近轮数（改大 = 记得更久，token 更贵）
HISTORY_TURNS=6
